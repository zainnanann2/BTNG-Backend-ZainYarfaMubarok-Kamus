APP_NAME="Kamus Bahasa Daerah API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Lokal (Laragon/XAMPP):
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=btng_kamus
#   DB_USERNAME=root
#   DB_PASSWORD=
#
# Clever Cloud (add-on MySQL) TIDAK mengisi DB_HOST/DB_DATABASE dan sejenisnya.
# Add-on menyuntikkan variabel berawalan MYSQL_ADDON_:
#   MYSQL_ADDON_HOST, MYSQL_ADDON_PORT, MYSQL_ADDON_DB,
#   MYSQL_ADDON_USER, MYSQL_ADDON_PASSWORD, MYSQL_ADDON_ROLE
#
# Railway (layanan MySQL) memakai nama berbeda tanpa garis bawah:
#   MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD
#
# config/database.php membaca keduanya sebagai cadangan bila DB_* kosong,
# sehingga di Clever Cloud maupun Railway baris DB_* di bawah tidak perlu
# diubah.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=btng_kamus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Dokumentasi API (Scramble)
# ---------------------------------------------------------------------------
# Halaman dokumentasi ada di /docs/api dan kontrak mentahnya di /docs/api.json.
# Pada APP_ENV=local, Scramble selalu terbuka. Di produksi, akses dijaga oleh
# gate "viewApiDocs" yang didefinisikan di app/Providers/AppServiceProvider.php.
API_VERSION=1.0.0
