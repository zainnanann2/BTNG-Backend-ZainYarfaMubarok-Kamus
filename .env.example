APP_NAME="Kamus Bahasa Daerah API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Lokal (Laragon/XAMPP):
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=btng_kamus
#   DB_USERNAME=root
#   DB_PASSWORD=
#
# Clever Cloud (MySQL add-on) mengisi variabel berikut secara otomatis
# lewat add-on, jadi biarkan nilai di bawah apa adanya di produksi:
#   DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=btng_kamus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Dokumentasi API (Scramble)
# ---------------------------------------------------------------------------
# Halaman dokumentasi ada di /docs/api dan kontrak mentahnya di /docs/api.json.
# Pada APP_ENV=local, Scramble selalu terbuka. Di produksi, akses dijaga oleh
# gate "viewApiDocs" yang didefinisikan di app/Providers/AppServiceProvider.php.
API_VERSION=1.0.0
